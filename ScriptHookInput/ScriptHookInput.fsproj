<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Platforms>x64</Platforms>
    <AssemblyTitle>Script Hook Inputs</AssemblyTitle>
    <Authors>Nozomu-san</Authors>
    <AssemblyVersion>04.10.2026.0</AssemblyVersion>
    <FileVersion>04.10.2026.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source\InputModel.fs" />
    <Compile Include="Source\InputParsing.fs" />
    <Compile Include="Source\InputActions.fs" />
    <Compile Include="Source\DeviceInput.fs" />
    <Compile Include="Source\GameInput.fs" />
    <Compile Include="Source\Runtime.fs" />
    <Compile Include="Source\Extension.fs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Alloc8orStandardNatives">
      <HintPath>..\Alloc8orStandardNatives\bin\x64\Release\net11.0\Alloc8orStandardNatives.dll</HintPath>
    </Reference>
    <Reference Include="CommunityScriptHookVDotNetCore">
      <HintPath>..\CommunityScriptHookVDotNetCore\bin\x64\Release\net11.0\CommunityScriptHookVDotNetCore.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>